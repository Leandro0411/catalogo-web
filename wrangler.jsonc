{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catalogo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.svg", "!/placeholder.svg"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalogo-db",
      "database_id": "98e61034-0f0e-4928-b9e0-8fd08edf57d9",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "aff25c4d4b724efb8084ddb1d962b69b",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
